{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Full Stack",
            "dependsOn": [
                "Run Frontend",
                "Run Backend"
            ],
            "dependsOrder": "parallel",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Frontend",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            }
        },
        {
            "label": "Run Backend",
            "type": "shell",
            "command": "${workspaceFolder}/backend/venv/Scripts/python",
            "args": [
                "-m",
                "uvicorn",
                "main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "problemMatcher": []
        }
    ]
}